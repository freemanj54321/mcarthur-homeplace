rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isEditor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/editors/$(request.auth.uid));
    }

    match /editors/{uid} {
      // Editors can read their own doc to confirm allowlist status.
      // Writes only happen via the Admin SDK (which bypasses rules).
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /pages/{pageId} {
      // Public can read only published pages.
      allow read: if resource.data.status == 'published';
      // Editors can read drafts and write anything.
      allow read, write: if isEditor();
    }

    // Existing photos collection: public read, editor write.
    match /photos/{photoId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Future structured collections (Phase 4).
    match /projects/{id}    { allow read: if true; allow write: if isEditor(); }
    match /events/{id}      { allow read: if true; allow write: if isEditor(); }
    match /milestones/{id}  { allow read: if true; allow write: if isEditor(); }
    match /boardMembers/{id}{ allow read: if true; allow write: if isEditor(); }
    match /partners/{id}    { allow read: if true; allow write: if isEditor(); }
    match /navigation/{id}  { allow read: if true; allow write: if isEditor(); }

    // Default-deny: anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
