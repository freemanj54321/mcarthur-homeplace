rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isEditor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/editors/$(request.auth.uid));
    }

    match /editors/{uid} {
      // Editors can read their own doc to confirm allowlist status.
      // Writes only happen via the Admin SDK (which bypasses rules).
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /pages/{pageId} {
      // Public can read only published pages.
      allow read: if resource.data.status == 'published';
      // Editors can read drafts and write anything.
      allow read, write: if isEditor();
    }

    // Existing photos collection: public read, editor write.
    match /photos/{photoId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Structured collections (Phase 4): public reads only published docs;
    // editors read drafts and write. (Server-side Admin SDK bypasses these,
    // so this is defense-in-depth against direct client access.)
    function structuredRead() { return resource.data.status == 'published'; }
    match /projects/{id}     { allow read: if structuredRead(); allow read, write: if isEditor(); }
    match /news/{id}         { allow read: if structuredRead(); allow read, write: if isEditor(); }
    match /events/{id}       { allow read: if structuredRead(); allow read, write: if isEditor(); }
    match /milestones/{id}   { allow read: if structuredRead(); allow read, write: if isEditor(); }
    match /boardMembers/{id} { allow read: if structuredRead(); allow read, write: if isEditor(); }
    match /partners/{id}     { allow read: if structuredRead(); allow read, write: if isEditor(); }

    match /navigation/{id}  { allow read: if true; allow write: if isEditor(); }

    // Default-deny: anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
