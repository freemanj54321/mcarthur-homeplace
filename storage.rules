rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isEditor() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/editors/$(request.auth.uid));
    }

    // Page-attached images uploaded by editors.
    match /pages/{allPaths=**} {
      allow read: if true;
      allow write: if isEditor()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Existing photos collection assets.
    match /photos/{allPaths=**} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
