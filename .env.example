# Local development environment. Copy to `.env.local` and fill in.
# `.env.local` is gitignored; never commit real values or keys.
#
# Deployed environments (dev/uat/prod on App Hosting) set NONE of these by
# hand: App Hosting injects the Firebase config and the Admin SDK runs keyless
# (ONBOARDING decision 4). Feature flags live in apphosting.<env>.yaml.

# ── Firebase web config (public, not secret) ─────────────────────────────────
# From Firebase console → Project settings → Your apps → Web app. For the dev
# project the values are also in GitHub → Settings → Variables (used by CI).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mcarthur-web-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mcarthur-web-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mcarthur-web-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Server credentials (Admin SDK) ───────────────────────────────────────────
# Preferred: no key at all. Run once:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project mcarthur-web-dev
# The foundation org blocks service-account keys, so this variable is only for
# the legacy mcarthur-tour project. Leave it unset otherwise.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Feature flags (off unless exactly "true") ────────────────────────────────
# Prototype donation flow (decision 8). "true" on dev/uat, "false" on prod.
NEXT_PUBLIC_DONATIONS_ENABLED=true
# Temporary design switcher / TweaksPanel (decision 2, MCA-24).
NEXT_PUBLIC_DESIGN_TOOLS_ENABLED=true

# ── Emulator-only: NEVER set these in a deployed environment ─────────────────
# `npm run test:e2e` sets them itself. Only uncomment to point `npm run dev`
# at `npm run emulators` by hand.
# NEXT_PUBLIC_FIREBASE_USE_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
