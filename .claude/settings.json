{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm info *)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run build)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc --noEmit)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-search",
      "mcp__claude_ai_Notion__notion-create-pages",
      "mcp__claude_ai_Notion__notion-update-page"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git config *)",
      "Bash(firebase deploy *)",
      "Bash(npx firebase deploy *)",
      "Bash(gcloud *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(./.env*)",
      "Read(**/*firebase-adminsdk*.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited-file.sh"
          }
        ]
      }
    ]
  }
}
