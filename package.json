{
  "name": "mcarthur-homeplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "firebase emulators:exec --project demo-mcarthur --only auth,firestore,storage \"node scripts/seed-emulator.mjs && playwright test\"",
    "test:e2e:ui": "firebase emulators:exec --project demo-mcarthur --only auth,firestore,storage \"node scripts/seed-emulator.mjs && playwright test --ui\"",
    "migrate:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate-content.mjs",
    "seed:editor": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-editor.mjs",
    "emulators": "firebase emulators:start --project demo-mcarthur --only auth,firestore,storage"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.5.0",
    "isomorphic-dompurify": "^3.19.0",
    "next": "16.3.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "firebase-tools": "^15.22.3",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "@firebase/util": true,
    "protobufjs": true,
    "re2": true,
    "unrs-resolver": true
  }
}
